# Community shim gateway
# Copy to .env. Keep credentials out of version control.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional for loopback use; required when binding to a non-loopback address.
# SHIM_API_KEY=REPLACE_ME_WITH_AT_LEAST_16_RANDOM_CHARACTERS

# Provider credentials can instead be supplied per request.
# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GOOGLE_API_KEY=REPLACE_ME

# Optional provider endpoints.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_READ_TIMEOUT_SECONDS=600
OPENAI_WRITE_TIMEOUT_SECONDS=600
OPENAI_POOL_TIMEOUT_SECONDS=600
ANTHROPIC_CONNECT_TIMEOUT_SECONDS=5
ANTHROPIC_READ_TIMEOUT_SECONDS=600
ANTHROPIC_WRITE_TIMEOUT_SECONDS=600
ANTHROPIC_POOL_TIMEOUT_SECONDS=600
GOOGLE_TIMEOUT_SECONDS=60

MAX_REQUEST_BODY_SIZE=32000000
TRUSTED_PROXIES=[]
BACKEND_CORS_ORIGINS=[]
PRIVACY_CHAIN_TTL_SECONDS=2592000
DEFAULT_RPM_LIMIT=60
DEFAULT_TPM_LIMIT=10000
COST_TAG_MAX_LENGTH=64
LOOP_REPEAT_LIMIT=8
LOOP_WINDOW_SECONDS=300

# Optional observability exporters.
# SENTRY_DSN=https://REPLACE_ME
# OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_ME
OTEL_SERVICE_NAME=shim-community
