# Cloud-only settings; combine with the enterprise environment. Never put live
# credentials in this file. Use a distinct merchant/catalog for each server.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_SERVER=sandbox
# JSON maps configured choices to Polar product UUIDs, not price IDs.
POLAR_PRODUCTS='{"managed:monthly":"00000000-0000-4000-8000-000000000001","managed:yearly":"00000000-0000-4000-8000-000000000002","agency:monthly":"00000000-0000-4000-8000-000000000003","agency:yearly":"00000000-0000-4000-8000-000000000004"}'
CLOUD_DASHBOARD_URL=http://localhost:3000
CLOUD_BILLING_RECONCILE_SECONDS=300
