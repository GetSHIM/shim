# shim Enterprise local deployment
# Copy to ee/.env. Replace every REPLACE_ME value and never commit that file.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://shim:shim@postgres:5432/shim
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
REDIS_URL=redis://redis:6379/0

SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_16_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_ME_WITH_A_FERNET_KEY
SECRET_BACKEND=fernet

SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_KEY=sb_publishable_REPLACE_ME

MAX_REQUEST_BODY_SIZE=32000000
TRUSTED_PROXIES=[]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_READ_TIMEOUT_SECONDS=600
OPENAI_WRITE_TIMEOUT_SECONDS=600
OPENAI_POOL_TIMEOUT_SECONDS=600
ANTHROPIC_CONNECT_TIMEOUT_SECONDS=5
ANTHROPIC_READ_TIMEOUT_SECONDS=600
ANTHROPIC_WRITE_TIMEOUT_SECONDS=600
ANTHROPIC_POOL_TIMEOUT_SECONDS=600
GOOGLE_TIMEOUT_SECONDS=60
PRIVACY_CHAIN_TTL_SECONDS=2592000

DEFAULT_RPM_LIMIT=60
DEFAULT_TPM_LIMIT=10000
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
COST_TAG_MAX_LENGTH=64
LOOP_REPEAT_LIMIT=8
LOOP_WINDOW_SECONDS=300

GATEWAY_RECONCILIATION_GRACE_SECONDS=120
GATEWAY_RECONCILIATION_INTERVAL_SECONDS=30
GATEWAY_RECONCILIATION_BATCH_SIZE=100
GATEWAY_OUTBOX_INTERVAL_SECONDS=5
GATEWAY_OUTBOX_BATCH_SIZE=100
GATEWAY_OUTBOX_LEASE_SECONDS=60
GATEWAY_OUTBOX_MAX_ATTEMPTS=8

COMPLIANCE_DEFAULT_INTERVAL_SECONDS=300
COMPLIANCE_DEFAULT_BACKFILL_HOURS=24
COMPLIANCE_ANTHROPIC_RPM=600
COMPLIANCE_OPENAI_RETENTION_DAYS=30
COMPLIANCE_RETENTION_RISK_DAYS=7
COMPLIANCE_SCAN_CONCURRENCY=4
# COMPLIANCE_HASH_SALT=REPLACE_ME
# RESEND_API_KEY=re_REPLACE_ME
# COMPLIANCE_EMAIL_FROM=compliance@example.com

AI_ACT_AUDIT_ENABLED=true
AI_ACT_AUDIT_RETENTION_DAYS=180
AI_ACT_AUDIT_ANCHOR_ENABLED=true
AI_ACT_AUDIT_WORKER_INTERVAL_SECONDS=3600
OVERSIGHT_ENABLED=false
OVERSIGHT_DEFAULT_TTL_SECONDS=3600
MANUAL_TEST_DASHBOARD_ENABLED=false

# Optional billing integration.
# LEMON_SQUEEZY_SIGNING_SECRET=REPLACE_ME
# LEMON_SQUEEZY_SOLO_PRO_MONTHLY_VARIANT_ID=REPLACE_ME
# LEMON_SQUEEZY_SOLO_PRO_YEARLY_VARIANT_ID=REPLACE_ME
# LEMON_SQUEEZY_AGENCY_MONTHLY_VARIANT_ID=REPLACE_ME
# LEMON_SQUEEZY_AGENCY_YEARLY_VARIANT_ID=REPLACE_ME

# Optional observability exporters.
# SENTRY_DSN=https://REPLACE_ME
# OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_ME
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=REPLACE_ME
OTEL_SERVICE_NAME=shim-enterprise

# The production Compose profile uses Google Cloud Secret Manager.
# GOOGLE_CLOUD_PROJECT=REPLACE_ME
# SHIM_IMAGE=REGISTRY/PROJECT/shim-enterprise:TAG
